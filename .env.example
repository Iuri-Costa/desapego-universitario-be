SPRING_PROFILES_ACTIVE=dev

PORT=8080
API_PORT=8080
APP_VERSION=1.0.0
LOG_FORMAT=logstash

DB_NAME=desapego_universitario
DB_PORT=5432
JDBC_URL=jdbc:postgresql://localhost:5432/desapego_universitario
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
JDBC_TIME_ZONE=UTC

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

ADMIN_BOOTSTRAP_EMAIL=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL=PT24H
PASSWORD_RESET_TTL=PT1H

RATE_LIMIT_LOGIN=5
RATE_LIMIT_CADASTRO=3
RATE_LIMIT_JANELA=PT1M
RATE_LIMIT_TRUSTED_PROXIES=

RESERVA_TTL=PT24H

EMAIL_DOMINIOS_INSTITUCIONAIS=edu.br,edu,ac.br

S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_PREFIX=anuncios
STORAGE_LOCAL_DIR=/tmp/desapego-uploads
APP_PUBLIC_URL=
STORAGE_MAX_IMAGENS=5
STORAGE_MAX_TAMANHO=2MB
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=25MB

FCM_CREDENTIALS=
FCM_PROJECT_ID=
FCM_SCOPE=https://www.googleapis.com/auth/firebase.messaging
FCM_OAUTH_URL=https://oauth2.googleapis.com/token
FCM_SEND_URL=https://fcm.googleapis.com/v1
FCM_DEVICE_TTL=P90D
FCM_CLEANUP_LOTE=500

OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SQL_LOG_LEVEL=WARN

LOG_LEVEL_ROOT=INFO
FORWARD_HEADERS_STRATEGY=native
